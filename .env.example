# Copy to .env and fill in. Every value below is optional except where marked
# required, and the service refuses to start if a required one is missing,
# listing all of them at once rather than one per restart.

# ─── Channels ────────────────────────────────────────────────────────────────
# Which messaging platforms to serve. Comma separated: whatsapp, telegram.
# Only the credentials of the channels listed here are required.
CHANNELS=telegram

# --- WhatsApp Business, via the Meta Graph API ---
# App Secret from the Meta app dashboard. Signs every inbound payload. REQUIRED
# when whatsapp is enabled: without it there is no way to tell a real delivery
# from anyone who learned the URL.
WHATSAPP_APP_SECRET=
# A random string you choose, echoed back during webhook registration. REQUIRED.
#   openssl rand -hex 32
WHATSAPP_VERIFY_TOKEN=
# Access token used to send replies. REQUIRED.
WHATSAPP_TOKEN=
# The phone number ID, not the phone number itself. REQUIRED.
WHATSAPP_PHONE_NUMBER_ID=
# Meta retires a Graph API version roughly two years after release. v18.0, the
# version this project used to hardcode, is long expired.
WHATSAPP_GRAPH_VERSION=v26.0

# --- Telegram Bot API ---
# Token from @BotFather. REQUIRED when telegram is enabled.
TELEGRAM_BOT_TOKEN=
# The secret_token you pass to setWebhook. Telegram echoes it back in a header
# on every request, and it is the only thing separating your bot from anyone
# who guessed the URL. REQUIRED.
#   openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# ─── Language model ──────────────────────────────────────────────────────────
# ai21 or ollama. Ollama runs locally and needs no account, which is the
# combination to pick if you just want to see this work.
AI_PROVIDER=ollama

# What the bot is. Used to be a hardcoded Spanish string inside the AI21
# adapter, which made a general-purpose repository into a fashion advisor.
AI_SYSTEM_PROMPT=You are a helpful assistant answering inside a chat app. Reply in the same language the user writes in. Keep answers short and concrete.
# Sent when the model fails or answers with nothing usable.
AI_FALLBACK_TEXT=Sorry, I can't answer right now. Please try again in a moment.
# Sent for images, stickers, voice notes and anything else that is not text.
AI_UNSUPPORTED_TEXT=I can only read text messages for now.
# The entire budget for a model call. There is no retry: somebody is waiting.
AI_TIMEOUT_MS=20000

# --- AI21 Studio ---
# REQUIRED when AI_PROVIDER=ai21.
AI21_API_KEY=
AI21_MODEL=jamba-large-1.7
AI21_MAX_TOKENS=512
AI21_TEMPERATURE=0.7

# --- Ollama ---
# On macOS or Windows with the app running on the host, reach it from a
# container at http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ─── Delivery ────────────────────────────────────────────────────────────────
SEND_TIMEOUT_MS=10000
# Retries only on 429, 5xx and network failures, with exponential backoff and
# Retry-After honoured. A lost reply is the failure a user actually notices.
SEND_RETRIES=2

# ─── Deduplication ───────────────────────────────────────────────────────────
# Platforms retry a delivery they did not see acknowledged: Meta keeps trying
# for up to 36 hours. Six hours is far more than a duplicate that matters needs.
DEDUP_TTL_MS=21600000
# Bounded by count as well as by time. A TTL alone is a memory leak waiting for
# a traffic spike.
DEDUP_MAX_ENTRIES=10000

# ─── Work queue ──────────────────────────────────────────────────────────────
# Messages handled at the same time behind the acknowledgement.
QUEUE_CONCURRENCY=4
# Messages allowed to wait. Past this the webhook answers 503 and lets the
# platform retry, which is backpressure rather than silent loss.
QUEUE_MAX_PENDING=500

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3000
# debug, info, warn or error. JSON, one object per line, never message bodies.
LOG_LEVEL=info
# Inbound bodies larger than this are rejected before any signature work.
HTTP_MAX_BODY_BYTES=131072

# ─── Shutdown ────────────────────────────────────────────────────────────────
# Time between /ready starting to answer 503 and the listener closing. Zero is
# right on a laptop. Behind a load balancer this has to exceed the health check
# interval, or the instance stops accepting connections before anything
# upstream notices it is going away.
SHUTDOWN_GRACE_MS=0
# How long to wait for accepted work to finish once the listener is closed.
SHUTDOWN_DRAIN_MS=10000
