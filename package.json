{
  "name": "messaging-llm-bridge",
  "version": "2.0.0",
  "description": "Messaging webhooks answered by a language model: verified signatures, fast acknowledgement and idempotent delivery (TypeScript, ports and adapters)",
  "type": "module",
  "main": "src/main.ts",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.ts",
    "dev": "node --env-file-if-exists=.env --watch src/main.ts",
    "test": "node --test",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "whatsapp",
    "whatsapp-business-api",
    "webhook",
    "hexagonal-architecture",
    "ports-and-adapters",
    "typescript",
    "nodejs",
    "express",
    "idempotency",
    "hmac"
  ],
  "author": "Sergio Santiago Henares <sersanhen@gmail.com> (https://github.com/sergio-santiago)",
  "license": "MIT",
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.9.2",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sergio-santiago/messaging-llm-bridge"
  }
}
